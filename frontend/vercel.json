{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/lifecycle-emails",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/social-daily",
      "schedule": "30 3 * * *"
    }
  ]
}
